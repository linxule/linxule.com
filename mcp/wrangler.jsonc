{
  "name": "linxule-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "services": [
    { "binding": "SITE", "service": "linxule-com" }
  ],
  "routes": [
    { "pattern": "linxule.com/mcp", "zone_name": "linxule.com" },
    { "pattern": "linxule.com/mcp/*", "zone_name": "linxule.com" }
  ],
  "vars": {
    "ALLOWED_HOSTS": "linxule.com",
    "SITE_ORIGIN": "https://linxule.com",
    "MCP_ENABLED": "1"
  },
  "env": {
    "local": {
      "routes": [],
      "services": [],
      "vars": {
        "ALLOWED_HOSTS": "127.0.0.1:8788",
        "SITE_ORIGIN": "https://linxule.com",
        "MCP_ENABLED": "1"
      }
    }
  }
}
