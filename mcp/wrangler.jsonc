{
  "name": "linxule-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "linxule.com/mcp", "zone_name": "linxule.com" },
    { "pattern": "linxule.com/mcp/*", "zone_name": "linxule.com" }
  ],
  "vars": {
    "ALLOWED_HOSTS": "linxule.com",
    "SITE_ORIGIN": "https://linxule.com",
    "MCP_ENABLED": "1"
  },
  "env": {
    "local": {
      "routes": [],
      "vars": {
        "ALLOWED_HOSTS": "127.0.0.1:8788",
        "SITE_ORIGIN": "https://linxule.com",
        "MCP_ENABLED": "1"
      }
    }
  }
}
