---
layout: layouts/base.njk
marker: "writing"
---

<style>
    .article-container {
        display: grid;
        grid-template-columns: 1fr minmax(0, var(--measure)) 280px 1fr;
        gap: 0 2rem;
        padding: 10rem 2rem 6rem;
        overflow-x: clip;
    }
    
    article {
        grid-column: 2;
        min-width: 0;
        overflow-wrap: anywhere;
    }
    
    .article-header {
        margin-bottom: 4rem;
    }
    
    .article-series {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        letter-spacing: var(--tracking-label);
        color: var(--ink-faint);
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }
    
    .article-title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 300;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }
    
    .article-subtitle {
        font-size: 1.2rem;
        font-weight: 300;
        font-style: italic;
        color: var(--ink-light);
        margin-bottom: 2rem;
    }
    
    .article-meta {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
    }
    
    .meta-label {
        color: var(--ink-faint);
    }
    
    .article-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.5rem;
    }
    
    .article-body {
        line-height: 1.8;
    }

    /* Blockquotes break the column rhythm - shift left */
    .article-body blockquote {
        margin: 2.5rem 0 2.5rem -2rem;
        padding: 1.5rem 0 1.5rem 1.5rem;
        border-left: 1px solid var(--ink-ghost);
        font-style: italic;
        color: var(--ink-light);
    }

    .article-body blockquote p {
        margin: 0 0 1rem 0;
        line-height: 1.9;
    }

    .article-body blockquote p:last-child {
        margin-bottom: 0;
    }

    .article-body blockquote strong {
        font-weight: 500;
        color: var(--ink);
        font-style: normal;
    }

    /* On mobile, no negative margin */
    @media (max-width: 768px) {
        .article-body blockquote {
            margin-left: 0;
        }
    }
    
    .pullquote {
        margin: 2.5rem 0;
        border-left: 2px solid var(--ink-ghost);
        padding-left: 1.5rem;
    }
    
    .pullquote-text {
        font-size: 1.05rem;
        font-style: italic;
        color: var(--ink-light);
        line-height: 1.9;
    }
    
    .pullquote-source {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
        margin-top: 0.75rem;
    }
    
    .external-link {
        display: inline-block;
        margin-top: 2rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-light);
        text-decoration: none;
        padding: 0.75rem 1.25rem;
        border: 1px solid var(--ink-ghost);
        transition: all 0.2s ease;
    }
    
    .external-link:hover {
        border-color: var(--bloom);
        color: var(--bloom);
    }
    
    .article-citation {
        margin-top: 3rem;
        padding: 1.5rem 2rem;
        background: var(--paper-dark, #e8e4dc);
        border-radius: 2px;
    }

    .citation-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        letter-spacing: var(--tracking-label);
        color: var(--ink-faint);
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .citation-terms {
        font-style: italic;
        color: var(--ink-light);
        font-size: var(--size-quiet);
        margin-bottom: 1rem;
    }

    .citation-term-name {
        font-weight: 500;
        color: var(--ink);
        font-style: normal;
    }

    .citation-full {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-light);
        line-height: 1.8;
    }

    .citation-copy {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
        background: none;
        border: 1px solid var(--ink-ghost);
        padding: 0.3rem 0.8rem;
        margin-top: 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .citation-copy:hover {
        color: var(--bloom);
        border-color: var(--bloom);
    }

    .article-license {
        margin-top: 2rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
        letter-spacing: var(--tracking-whisper);
    }

    .article-license a {
        color: var(--ink-faint);
        text-decoration-color: var(--ink-ghost);
    }

    .article-license a:hover {
        color: var(--bloom);
    }

    .article-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink-ghost);
        display: flex;
        justify-content: space-between;
    }
    
    .nav-link {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
    }

    .page-marker {
        font-family: 'IBM Plex Mono', monospace;
        font-size: var(--size-label);
        color: var(--ink-faint);
    }
    
    @media (max-width: 1100px) {
        .article-container {
            grid-template-columns: 1fr minmax(0, var(--measure)) 1fr;
        }
    }
    
    @media (max-width: 768px) {
        .article-container {
            grid-template-columns: minmax(0, 1fr);
            padding: 8rem 1.5rem 4rem;
        }
        
        article {
            grid-column: 1;
        }
    }
</style>

<div class="article-container">

    <article data-pagefind-body data-pagefind-filter="type:writing">
        
        <header class="article-header">
            {% if series %}
            <div class="article-series">{{ series }}</div>
            {% endif %}
            <h1 class="article-title{% if accident %} accident{% endif %}">{{ title }}</h1>
            {% if subtitle %}
            <p class="article-subtitle">{{ subtitle }}</p>
            {% endif %}
            <div class="article-meta">
                {% if authors %}
                <span class="meta-item">
                    <span class="meta-label">with</span>
                    <span>{{ authors | join(", ") }}</span>
                </span>
                {% endif %}
                <span class="meta-item">
                    <span class="meta-label">date</span>
                    <span>{{ date | readableDate }}</span>
                </span>
            </div>
            {% if keywords %}
            <div class="article-tags">
                {% for keyword in keywords %}
                <a href="/tag/{{ keyword | slugify }}/" class="tag">{{ keyword }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </header>
        
        <div class="article-body">
            {{ content | safe }}
        </div>
        
        {% if link %}
        <a href="{{ link }}" class="external-link">Read on Thread Counts →</a>
        {% endif %}

        {% if defines %}
        <div class="article-citation">
            <div class="citation-label">cite this</div>
            <div class="citation-terms">
                {% for def in defines %}
                <span class="citation-term-name">{{ def.term }}</span>{% if not loop.last %}, {% endif %}
                {% endfor %}
                — first defined here.
            </div>
            <div class="citation-full" id="citation-text">{{ authors | join(", ") }} ({{ date | readableDate }}). "{{ title }}." {{ site.url }}{{ page.url }}</div>
            <button class="citation-copy" onclick="navigator.clipboard.writeText(document.getElementById('citation-text').textContent.trim()).then(()=>{this.textContent='copied';setTimeout(()=>{this.textContent='copy'},1500)})">copy</button>
        </div>
        {% endif %}

        <div class="article-license">
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a> — use this, build on it, cite it.
        </div>

        <footer class="article-footer">
            <a href="/writing/" class="nav-link">← all writing</a>
            <span class="page-marker">003</span>
        </footer>
        
    </article>

</div>

<!-- Article Image Lightbox -->
<div class="lightbox" id="article-lightbox" role="dialog" aria-modal="true" aria-label="Image lightbox" aria-hidden="true">
    <button type="button" class="lightbox-close" aria-label="Close lightbox">close</button>
    <img alt="Enlarged image view">
</div>

<script defer src="/assets/js/writing-lightbox.js?v={{ site.version }}"></script>

<!-- Marginalia placement: each note as close to its reference as the notes before it allow -->
<script>
(function() {
    var body = document.querySelector('.article-body');
    var marginalia = body && body.querySelector('.marginalia');
    if (!marginalia) return;
    var notes = Array.prototype.slice.call(marginalia.querySelectorAll('.margin-note'));
    if (!notes.length) return;

    // The same string as the CSS margin block; its complement is the endnote
    // query (max-width: 1100px).
    var MQ = window.matchMedia('not all and (max-width: 1100px)');
    var GAP = 12;
    // A note may start at most this far above its reference (about 3.5 lines of
    // body text); further up, it reads as belonging to the sentence before.
    var MAX_RISE = 120;

    // Least-squares tops: minimise sum (p_i - d_i)^2 over the wanted tops d_i
    // (each reference) subject to p_(i+1) >= p_i + h_i + GAP, p_1 >= 0 and the
    // last note ending inside the article. Subtracting the cumulative heights
    // turns the spacing constraint into plain monotonicity, which
    // pool-adjacent-violators solves in one pass. A crowded run of notes then
    // centres on its references instead of trailing below them.
    function solve(wanted, heights, limit) {
        var n = wanted.length, offset = [], blocks = [], acc = 0, i;
        for (i = 0; i < n; i++) {
            offset.push(acc);
            blocks.push({ sum: wanted[i] - acc, count: 1 });
            acc += heights[i] + GAP;
            while (blocks.length > 1) {
                var b = blocks[blocks.length - 1], a = blocks[blocks.length - 2];
                if (a.sum / a.count <= b.sum / b.count) break;
                a.sum += b.sum; a.count += b.count;
                blocks.pop();
            }
        }
        var hi = limit - offset[n - 1] - heights[n - 1];
        if (hi < 0) hi = Infinity;
        var tops = [], floor = 0, k = 0;
        blocks.forEach(function(b) {
            var q = Math.max(0, Math.min(hi, b.sum / b.count));
            for (var j = 0; j < b.count; j++, k++) {
                // The rise cap only ever moves a note down, so a forward pass
                // keeps every note clear of the one before it.
                var p = Math.max(q + offset[k], wanted[k] - MAX_RISE, floor);
                tops.push(p);
                floor = p + heights[k] + GAP;
            }
        });
        return tops;
    }

    // Writes only `top` (and .positioned, which changes opacity) on notes that
    // are absolutely positioned inside a zero-height box, so placing them never
    // resizes the article or a note: the observer below cannot feed itself.
    var placed = false;
    function position() {
        if (!MQ.matches) {
            notes.forEach(function(n) {
                n.style.top = '';
                n.classList.add('positioned');
            });
            return;
        }

        // The first placement appears at once instead of fading in.
        var instant = !placed;
        placed = true;
        if (instant) {
            notes.forEach(function(n) { n.style.transition = 'none'; });
        }

        var bodyRect = body.getBoundingClientRect();
        var wanted = [], heights = [], last = 0;
        notes.forEach(function(note) {
            var ref = body.querySelector('.fn-ref[href="#' + note.id + '"]');
            last = ref ? ref.getBoundingClientRect().top - bodyRect.top : last;
            wanted.push(last);
            heights.push(note.offsetHeight);
        });

        var tops = solve(wanted, heights, bodyRect.height);
        notes.forEach(function(note, i) {
            note.style.top = tops[i] + 'px';
            note.classList.add('positioned');
        });

        if (instant) {
            marginalia.offsetHeight;
            notes.forEach(function(n) { n.style.transition = ''; });
        }
    }

    // The script follows the article, so its layout exists already (fonts or not).
    position();

    if (window.ResizeObserver) {
        // Anything that moves a reference changes the article's size: a late
        // font swap, an image arriving without reserved height, a <details>
        // opening, a width change. Notes are watched too, because their width
        // follows the viewport (20vw) while the article column may not, and
        // crossing the breakpoint resizes both. That covers window resize and
        // the media query, so there are no separate listeners for them. The
        // observer reports once per frame, after layout and before paint, so
        // re-placing here costs no frame of lag.
        var ro = new ResizeObserver(function() { position(); });
        ro.observe(body);
        notes.forEach(function(n) { ro.observe(n); });
    } else {
        var again = function() { position(); };
        if (document.fonts) document.fonts.ready.then(again);
        window.addEventListener('load', again);
        // Engines this old also lack MediaQueryList.addEventListener; resizing
        // is the only way across the breakpoint anyway.
        var timer;
        window.addEventListener('resize', function() {
            clearTimeout(timer);
            timer = setTimeout(again, 100);
        });
    }

    // Marginalia bloom — ref and note highlight together on hover
    document.querySelectorAll('.fn-ref').forEach(function(ref) {
        var noteId = ref.getAttribute('href');
        if (!noteId) return;
        var note = document.querySelector(noteId);
        if (!note) return;

        ref.addEventListener('mouseenter', function() { note.classList.add('bloom-active'); });
        ref.addEventListener('mouseleave', function() { note.classList.remove('bloom-active'); });
        ref.addEventListener('focus', function() { note.classList.add('bloom-active'); });
        ref.addEventListener('blur', function() { note.classList.remove('bloom-active'); });

        note.addEventListener('mouseenter', function() { ref.classList.add('bloom-active'); });
        note.addEventListener('mouseleave', function() { ref.classList.remove('bloom-active'); });
    });
})();
</script>
