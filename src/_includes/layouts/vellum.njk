---
layout: layouts/base.njk
preloadDisplay: true
preloadItalic: true
marker: builds
---
{%- set liveSurface = liveUrl | default('https://vellum.linxule.com') -%}
{%- set sourceRepo = repoUrl | default('https://github.com/linxule/vellum') -%}
{%- set licenseHref = licenseUrl | default('https://github.com/linxule/vellum/blob/main/LICENSE') -%}
{%- set canonicalUrl = site.url ~ (page.url | stripTrailingSlash) -%}
<style>
    /* An undated Builds note, using the site's paper/detail-page vocabulary. */
    /* The text is the measure; the 2rem padding sits outside it */
    .vellum-note { max-width: calc(var(--measure) + 4rem); margin: 10rem auto 6rem; padding: 0 2rem; overflow-wrap: anywhere; }
    .vellum-label { font-family: var(--font-mono); font-size: var(--size-label); letter-spacing: var(--tracking-whisper); text-transform: uppercase; color: var(--ink-faint); }
    .vellum-note h1 { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 300; line-height: 1.2; margin: .6rem 0 1rem; }
    .vellum-subtitle { font-size: var(--size-entry); font-style: italic; color: var(--ink-light); }
    .vellum-links { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin: 1.5rem 0; font-family: var(--font-mono); font-size: var(--size-label); }
    .vellum-opening { margin: 3rem 0; line-height: 1.8; }
    .vellum-opening span { display: block; }
    .vellum-opening span:nth-child(2) { margin-left: 1.5rem; }
    .vellum-opening span:nth-child(3) { margin-left: .75rem; }
    .vellum-opening span:nth-child(4) { margin-left: 2.25rem; }
    /* Collaborator provenance list styled as a ruled colophon ledger */
    .vellum-note .article-body ul {
        list-style: none;
        padding-left: 0;
        margin: 2rem 0;
        border-top: 1px solid var(--ink-ghost);
    }
    .vellum-note .article-body ul li {
        padding: 0.85rem 0;
        margin-bottom: 0;
        border-bottom: 1px solid var(--ink-ghost);
        font-size: var(--size-quiet);
        line-height: 1.8;
        color: var(--ink-light);
    }
    .vellum-note .article-body ul li strong {
        color: var(--ink);
    }
    .vellum-footer { border-top: 1px solid var(--ink-ghost); margin-top: 3rem; padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
    @media (max-width: 768px) {
        .vellum-note { margin: 6rem auto 3rem; padding: 0 1.5rem; }
        .vellum-opening span:nth-child(n) { margin-left: 0; }
    }
</style>
<article class="vellum-note" data-pagefind-body data-pagefind-filter="type:builds">
    <header>
        <div class="vellum-label">Builds · public experiment</div>
        <h1>{{ title }}</h1>
        <p class="vellum-subtitle">{{ subtitle }}</p>
        <nav class="vellum-links" aria-label="Explore {{ title }}">
            {% if liveSurface %}<a href="{{ liveSurface }}">live surface →</a>{% endif %}
            {% if sourceRepo %}<a href="{{ sourceRepo }}">public source →</a>{% endif %}
        </nav>
    </header>
    <p class="vellum-opening">
        {% for line in opening %}
        <span{% if line.accident %} class="accident"{% endif %}>{{ line.text | default(line) }}</span>
        {% endfor %}
    </p>
    <div class="article-body">{{ content | safe }}</div>
    <footer class="vellum-footer">
        <a href="/builds" class="back-link">← all builds</a>
        <a href="/making" class="back-link">making →</a>
    </footer>
</article>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ title | jsonScript | safe }},
  "description": {{ description | jsonScript | safe }},
  "url": {{ canonicalUrl | jsonScript | safe }},
  "mainEntityOfPage": {{ canonicalUrl | jsonScript | safe }},
  "about": {
    "@type": "SoftwareSourceCode",
    "name": {{ title | jsonScript | safe }},
    "url": {{ liveSurface | jsonScript | safe }},
    "codeRepository": {{ sourceRepo | jsonScript | safe }},
    "license": {{ licenseHref | jsonScript | safe }},
    "author": {"@type": "Person", "@id": {{ (site.url ~ "/#person") | jsonScript | safe }}, "name": {{ site.author | jsonScript | safe }}}
  }
}
</script>
