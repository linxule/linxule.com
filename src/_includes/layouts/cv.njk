---
layout: layouts/base.njk
preloadDisplay: true
marker: "cv"
---
{%- set isZh = lang and lang.startsWith('zh') -%}

<style>
    main {
        padding: 10rem 4rem 6rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .cv-container {
        position: relative;
    }

    .cv-header-meta {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .lang-switch {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        letter-spacing: var(--tracking-quiet);
        color: var(--ink-faint);
        text-decoration: none;
        border-bottom: 1px solid var(--ink-ghost);
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .lang-switch:hover,
    .lang-switch:focus-visible {
        color: var(--bloom);
        border-color: var(--bloom);
    }

    .page-marker {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
    }

    /* CV Header - name (promoted to h1 by cvHtml filter) */
    .cv-content > h1:first-of-type {
        font-family: var(--font-display);
        font-size: clamp(1.3rem, 2.2vw, 1.8rem);
        font-weight: 300;
        margin-bottom: 0.5rem;
        border: none;
        padding: 0;
        margin-top: 0;
        padding-right: 6rem;
    }

    /* Contact info (converted from h3 to p.cv-contact by cvHtml filter) */
    .cv-content > .cv-contact {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        font-style: normal;
        font-weight: 400;
        margin: 0.25rem 0;
        line-height: 1.8;
    }

    .cv-content > .cv-contact a {
        color: var(--ink-faint);
    }

    .cv-content > .cv-contact a:hover {
        color: var(--bloom);
    }

    /* Section headers (demoted from h1 to h2 by cvHtml filter) */
    .cv-content h2 {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        letter-spacing: var(--tracking-marker);
        color: var(--ink-faint);
        text-transform: uppercase;
        margin: 3rem 0 1.5rem;
        padding: 0 0 0.5rem;
        border-top: none;
        border-bottom: 1px solid var(--ink-ghost);
        font-weight: 400;
    }

    .cv-content h2:first-of-type {
        margin-top: 2rem;
    }

    /* Research interests paragraph */
    .cv-content > p:not(.cv-contact) {
        font-size: var(--size-quiet);
        color: var(--ink-light);
        line-height: 2;
        max-width: 650px;
    }

    /* The accident: "What forms of organizing emerge?" */
    .cv-content > p em {
        font-style: italic;
    }

    /* Entry lists */
    .cv-content > ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .cv-content > ul > li {
        margin-bottom: 0.75rem;
        font-size: var(--size-quiet);
        line-height: 1.7;
    }

    /* Handle <br/> spacing between major entries */
    .cv-content > ul > li > br:first-child {
        display: block;
        content: "";
        margin-top: 1rem;
    }

    /* Nested lists (details under entries) */
    .cv-content > ul > li > ul {
        list-style: none;
        padding: 0;
        margin: 0.25rem 0 0 1.5rem;
    }

    .cv-content > ul > li > ul > li {
        font-size: var(--size-quiet);
        color: var(--ink-light);
        line-height: 1.8;
        margin-bottom: 0.25rem;
        position: relative;
        padding-left: 1rem;
    }

    .cv-content > ul > li > ul > li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: var(--ink-ghost); /* ornament */
    }

    /* Third level nesting */
    .cv-content > ul > li > ul > li > ul {
        list-style: none;
        padding: 0;
        margin: 0.25rem 0 0.5rem 0.5rem;
    }

    .cv-content > ul > li > ul > li > ul > li {
        font-size: var(--size-quiet);
        color: var(--ink-light);
        line-height: 1.7;
        margin-bottom: 0.25rem;
        position: relative;
        padding-left: 1rem;
    }

    .cv-content > ul > li > ul > li > ul > li::before {
        content: "·";
        position: absolute;
        left: 0.2rem;
        color: var(--ink-ghost); /* ornament */
    }

    /* Fourth level nesting */
    .cv-content > ul > li > ul > li > ul > li > ul {
        list-style: none;
        padding: 0;
        margin: 0.25rem 0 0.5rem 0.5rem;
    }

    .cv-content > ul > li > ul > li > ul > li > ul > li {
        font-size: var(--size-note);
        color: var(--ink-faint);
        line-height: 1.6;
        margin-bottom: 0.2rem;
        position: relative;
        padding-left: 1rem;
    }

    .cv-content > ul > li > ul > li > ul > li > ul > li::before {
        content: "·";
        position: absolute;
        left: 0.2rem;
        color: var(--ink-ghost); /* ornament */
    }

    /* Links */
    .cv-content a {
        text-decoration: underline;
        text-decoration-color: var(--ink-ghost);
        text-underline-offset: 0.15em;
        transition: color 0.2s ease, text-decoration-color 0.2s ease;
    }

    .cv-content a:hover {
        color: var(--bloom);
        text-decoration-color: var(--bloom);
    }

    /* Emphasis */
    .cv-content strong {
        font-weight: 500;
    }

    /* Professional affiliations - plain text with line breaks */
    .cv-content > p br {
        display: block;
        content: "";
        margin-bottom: 0.25rem;
    }

    /* Footer */
    .cv-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink-ghost);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cv-updated {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
    }

    @media print {
        main { padding: 2rem; }
        .cv-footer { display: none; }
        .cv-header-meta { display: none; }
    }

    @media (max-width: 768px) {
        main {
            padding: 6rem 1.5rem 3rem;
        }
    }
</style>

<div class="cv-container">
    <div class="cv-header-meta">
        {% if isZh %}
        <a href="/cv" class="lang-switch" lang="en" aria-label="Switch to English CV">EN</a>
        <span class="page-marker" lang="zh">简历</span>
        {% else %}
        <a href="/cv-zh" class="lang-switch" lang="zh" aria-label="切换至中文简历">中文</a>
        <span class="page-marker">CV</span>
        {% endif %}
    </div>
    <div class="cv-content" data-pagefind-body data-pagefind-filter="type:cv">
        {{ content | cvHtml | safe }}
    </div>
</div>

<footer class="cv-footer">
    {% if isZh %}
    <a href="/" class="back-link">← 返回</a>
    <span class="cv-updated">更新于 {{ page.date | readableDate }}</span>
    {% else %}
    <a href="/" class="back-link">← return</a>
    <span class="cv-updated">updated {{ page.date | readableDate }}</span>
    {% endif %}
</footer>
