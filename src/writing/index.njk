---
ogImage: /assets/og-cards/writing.jpg
layout: layouts/base.njk
preloadItalic: true
title: writing
marker: "writing"
seoTitle: "Writing — essays on human–AI collaboration"
seoDescription: "Essays on human–AI collaboration in qualitative research — the LOOM, Organizational Futures, and Research with AI series — written with AI, not only about it."
---

<style>
    main {
        padding: 12rem 4rem 6rem;
        max-width: 1200px;
        margin: 0 auto;
    }
    
    .page-header {
        margin-bottom: 6rem;
        position: relative;
    }

    .header-links {
        position: absolute;
        top: 0;
        right: 0;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .search-link {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        letter-spacing: var(--tracking-quiet);
        color: var(--ink-faint);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .search-link:hover {
        color: var(--bloom);
    }

    .page-marker {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
    }

    .page-title {
        font-size: 1rem;
        font-weight: 400;
        margin-bottom: 1rem;
    }
    
    .page-description {
        font-size: var(--size-quiet);
        color: var(--ink-light);
        max-width: 450px;
    }
    
    .page-description a {
        text-decoration: underline;
        text-decoration-color: var(--ink-ghost);
    }
    
    .entries {
        padding-left: 180px;
    }
    
    .entry {
        margin-bottom: 1.5rem;
        position: relative;
    }
    
    .entry-link {
        display: inline-block;
        text-decoration: none;
        transition: transform 0.2s ease;
    }
    
    .entry-link:hover {
        transform: translateX(0.5rem);
    }
    
    .entry-series {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        color: var(--ink-faint);
        letter-spacing: var(--tracking-quiet);
        display: block;
        margin-bottom: 0.25rem;
    }

    .entry-title {
        font-size: 1.1rem;
        font-weight: 400;
        color: var(--ink-light);
        transition: color 0.2s ease;
    }

    .entry-title.accident {
        color: var(--accident);
    }

    .entry-link:hover .entry-title {
        color: var(--bloom);
    }

    .entry-date {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        color: var(--ink-faint);
        margin-left: 1rem;
    }

    .entry-subtitle {
        display: block;
        font-size: var(--size-quiet);
        font-style: italic;
        color: var(--ink-faint);
        margin-top: 0.15rem;
        margin-left: 1rem;
    }

    .entry-link:hover .entry-subtitle {
        color: var(--ink-light);
    }

    /* Visually hidden but accessible to screen readers and LLMs */
    .entry-description {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        white-space: nowrap;
        border: 0;
    }

    /* Stagger entries - 7-entry repeating wave */
    .entry:nth-child(7n+1) { padding-left: 0; }
    .entry:nth-child(7n+2) { padding-left: 2rem; }
    .entry:nth-child(7n+3) { padding-left: 4rem; }
    .entry:nth-child(7n+4) { padding-left: 5rem; }
    .entry:nth-child(7n+5) { padding-left: 3rem; }
    .entry:nth-child(7n+6) { padding-left: 1.5rem; }
    .entry:nth-child(7n)   { padding-left: 0.5rem; }
    
    .page-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink-ghost);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .subscribe-link {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        text-decoration: none;
        letter-spacing: var(--tracking-whisper);
    }

    .subscribe-link:hover {
        color: var(--bloom);
    }

    /* Filter chips */
    .filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        font-family: var(--font-mono);
        font-size: var(--size-label);
        margin-bottom: 4rem;
    }

    .filter-chip {
        color: var(--ink-faint);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .filter-chip:not(.active) {
        text-decoration: underline;
        text-decoration-color: var(--ink-ghost);
        text-underline-offset: 3px;
    }

    .filter-chip:hover {
        color: var(--bloom);
    }

    .filter-chip.active {
        color: var(--ink);
        text-decoration: none;
    }

    .chip-count {
        font-size: var(--size-whisper);
        color: var(--ink-faint);
        margin-left: 0.2rem;
    }

    /* Formal papers shelf — lives inside Writing rather than adding a homepage lane */
    .papers-shelf {
        margin-bottom: 4rem;
        padding: 1.5rem 0;
        border-top: 1px solid var(--ink-ghost);
        border-bottom: 1px solid var(--ink-ghost);
    }

    .papers-shelf-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1rem;
    }

    .papers-shelf-label {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--ink-faint);
    }

    .papers-shelf-all {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        letter-spacing: var(--tracking-whisper);
        color: var(--ink-faint);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .papers-shelf-all:hover {
        color: var(--bloom);
    }

    .papers-shelf-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .papers-shelf-link {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 1.25rem;
        text-decoration: none;
        transition: transform 0.2s ease;
    }

    .papers-shelf-link:hover {
        transform: translateX(0.35rem);
    }

    .papers-shelf-title {
        font-size: var(--size-quiet);
        font-style: italic;
        color: var(--ink-light);
        transition: color 0.2s ease;
    }

    .papers-shelf-link:hover .papers-shelf-title {
        color: var(--bloom);
    }

    .papers-shelf-meta {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        letter-spacing: var(--tracking-quiet);
        color: var(--ink-faint);
    }

    @media (max-width: 900px) {
        main {
            padding: 8rem 2rem 4rem;
        }
        
        .entries {
            padding-left: 0;
        }
        
        .entry:nth-child(n) {
            padding-left: 0;
        }
    }

    @media (max-width: 768px) {
        main {
            padding: 6rem 1.5rem 3rem;
        }

        .page-header {
            margin-bottom: 4rem;
        }
    }
</style>

<header class="page-header">
    <h1 class="page-title">writing</h1>
    <p class="page-description">
        Recent work published at <a href="https://threadcounts.substack.com/">Thread Counts</a>
        (also on <a href="https://github.com/linxule/loom">GitHub</a> with Chinese versions).
        Archive includes earlier tutorials and resources.
    </p>
    <div class="header-links">
        <a href="/search" class="search-link">search</a>
        <span class="page-marker">003</span>
    </div>
</header>

<nav class="filter-chips" aria-label="Filter writing by series">
    <span class="filter-chip active">all <span class="chip-count">{{ collections.writing | length }}</span></span>
    {%- for series in collections.writingBySeries -%}
    <a href="/writing/series/{{ series.slug }}" class="filter-chip">{{ series.name | lower }} <span class="chip-count">{{ series.count }}</span></a>
    {%- endfor -%}
</nav>

{%- if collections.papers and collections.papers.length -%}
<section class="papers-shelf" aria-labelledby="papers-shelf-label">
    <div class="papers-shelf-head">
        <span class="papers-shelf-label" id="papers-shelf-label">peer-reviewed &amp; preprints</span>
        <a href="/papers" class="papers-shelf-all">all papers →</a>
    </div>
    <ul class="papers-shelf-list">
        {%- for paper in collections.papers -%}
        <li>
            <a href="{{ paper.url | stripTrailingSlash }}" class="papers-shelf-link">
                <span class="papers-shelf-title">{{ paper.data.paperTitle | default(paper.data.title) }}</span>
                <span class="papers-shelf-meta">{{ paper.data.venue | default('Preprint') }}{% if paper.data.year %} · {{ paper.data.year }}{% endif %}</span>
            </a>
        </li>
        {%- endfor -%}
    </ul>
</section>
{%- endif -%}

<div class="entries">
    {%- for post in collections.writing -%}
    <div class="entry">
        <a href="{{ post.url | stripTrailingSlash }}" class="entry-link">
            {%- if post.data.series -%}
            <span class="entry-series">{{ post.data.series }}</span>
            {%- endif -%}
            <span class="entry-title{% if post.data.accident %} accident{% endif %}">{{ post.data.title }}</span>
            <span class="entry-date">{{ post.date | readableDate }}</span>
            {%- if post.data.subtitle -%}
            <span class="entry-subtitle">{{ post.data.subtitle }}</span>
            {%- endif -%}
            {%- if post.data.description -%}
            <span class="entry-description">{{ post.data.description | truncate(120) }}</span>
            {%- endif -%}
        </a>
    </div>
    {%- endfor -%}
</div>

<footer class="page-footer">
    <a href="/" class="back-link">← return</a>
    <a href="/feed.xml" class="subscribe-link">subscribe via rss →</a>
</footer>
