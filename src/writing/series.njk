---
pagination:
  data: collections.writingBySeries
  size: 1
  alias: series
  addAllPagesToCollections: true
permalink: /writing/series/{{ series.slug }}/
layout: layouts/base.njk
preloadDisplay: true
marker: writing
eleventyComputed:
  title: "{{ series.name }} · writing"
  seoTitle: "{{ (seriesCatalog.bySlug[series.slug] and seriesCatalog.bySlug[series.slug].seoTitle) or (series.name ~ ' · writing') }}"
  seoDescription: "{{ (seriesCatalog.bySlug[series.slug] and seriesCatalog.bySlug[series.slug].seoDescription) or '' }}"
---

<style>
    main {
        padding: 0;
        max-width: none;
        margin: 0;
    }
</style>

{% set seriesMeta = seriesCatalog.bySlug[series.slug] %}
{% set essays = series.items %}
{% set headerTitle = series.name %}
{% set headerCount = series.count %}
{% set backLink = "/writing" %}
{% set backText = "← all writing" %}

{% if seriesMeta %}
  {% if seriesMeta.poemHtml %}
    {% set headerPoem = seriesMeta.poemHtml %}
  {% endif %}
  {% if seriesMeta.description %}
    {% set headerDescription = seriesMeta.description %}
  {% endif %}
  {% if seriesMeta.companion %}
    {% set companionLink = seriesMeta.companion.link %}
    {% set companionLabel = seriesMeta.companion.label %}
    {% set companionNote = seriesMeta.companion.note %}
    {% set companionCta = seriesMeta.companion.cta %}
  {% endif %}
{% endif %}

{% include "components/writing-book.njk" %}
