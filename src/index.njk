    /* Five authored lines, stepped. The block is as wide as its longest line
       (the fourth: three steps plus "organizational life"), so no line wraps;
       a fixed 400px cap broke the third and fourth lines once the type passed
       28px, and the turnovers fell back to the left edge. */
    .core-question {
        --step: 2em;
        font-family: var(--font-display);
        font-size: clamp(1.4rem, 2.5vw, 2.2rem);
        font-weight: 300;
        line-height: 1.8;
        width: max-content;
        max-width: 100%;
        margin-left: auto;
    }
    
    .core-question .line {
        display: block;
    }
    
    .core-question .line:nth-child(2) { text-indent: var(--step); }
    .core-question .line:nth-child(3) { text-indent: calc(var(--step) * 2); }
    .core-question .line:nth-child(4) { text-indent: calc(var(--step) * 3); }
    .core-question .line:nth-child(5) { text-indent: 0; }

    /* The narrowest phones: a shallower step keeps the fourth line whole. */
    @media (max-width: 340px) {
        .core-question { --step: 1.5em; }
    }
    
    .core-question:hover .line {
        color: var(--ink-light);
    }
    
    /* The accident keeps its colour under hover (main.css "The Accident"). */
    .core-question .line:not(.accident):hover {
        color: var(--bloom) !important;
    }

    .core-question .line.accident {
        color: var(--accident);
    }

    .page-marker {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        text-align: right;
    }
    
    .spread-two {
        align-items: center;
    }
    
    .arc-container {
        position: relative;
        height: 60vh;
    }
    
    .arc {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 50vw;
        height: 50vw;
        border: 1px solid var(--ink-ghost);
        border-radius: 50%;
        opacity: 0.3;
        transition: border-color 0.5s ease, opacity 0.5s ease;
    }
    
    .arc-container:hover .arc {
        border-color: var(--bloom);
        opacity: 0.5;
    }
    
    .pathways {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-left: 2rem;
    }
    
    .pathway {
        font-size: 1rem;
        color: var(--ink-faint);
        font-weight: 400;
        transition: color 0.3s ease, transform 0.3s ease;
        position: relative;
    }
    
    .pathway:hover {
        color: var(--bloom);
        transform: translateX(0.5rem);
    }
    
    .pathway-num {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        position: absolute;
        left: -2rem;
        top: 0.2rem;
    }
    
    .pathway:hover .pathway-num {
        color: var(--bloom);
    }
    
    .spread-three {
        min-height: 50vh;
        align-items: end;
        padding-bottom: 8vh;
    }
    
    .closing-left {
        font-size: var(--size-quiet);
        color: var(--ink-light);
        line-height: 2;
    }
    
    .closing-links {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-end;
    }
    
    .closing-links a {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        text-decoration: none;
    }
    
    .closing-links a:hover {
        color: var(--bloom);
    }

    .cv-group {
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
    }

    .correspondence-group {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-top: 0.5rem;
    }
    
    .correspondence-label {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
    }
    
    .correspondence-group a {
        font-family: var(--font-mono);
        font-size: var(--size-label);
    }
    
    @media (max-width: 768px) {
        .spread {
            grid-template-columns: 1fr;
            padding: 6vh 6vw;
        }
        
        .right-field {
            height: auto;
            gap: 4rem;
        }
        
        .arc-container {
            display: none;
        }
        
        .pathways {
            padding-left: 0;
        }

        .pathway-num {
            position: static;
            display: inline-block;
            margin-right: 0.5rem;
            vertical-align: baseline;
        }
    }
</style>

