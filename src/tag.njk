---
pagination:
  data: collections.tagPages
  size: 1
  alias: tag
permalink: /tag/{{ tag.slug }}/
layout: layouts/base.njk
preloadDisplay: true
marker: tag
eleventyComputed:
  robots: "noindex, follow"
  seoTitle: "Tagged: {{ tag.name }}"
---

{%- set hasWriting = tag.writing and tag.writing.length >= 1 -%}
{%- set hasPapers = tag.papers and tag.papers.length >= 1 -%}
{%- set hasTalks = tag.talks and tag.talks.length >= 1 -%}
{%- set hasPortraits = tag.portraits and tag.portraits.length >= 1 -%}
{%- set hasArtifacts = tag.artifacts and tag.artifacts.length >= 1 -%}
{%- set writingOnly = hasWriting and not hasPapers and not hasTalks and not hasPortraits and not hasArtifacts -%}
{%- set anyContent = hasWriting or hasPapers or hasTalks or hasPortraits or hasArtifacts -%}

<style>
    {% if writingOnly %}
    main {
        padding: 0;
        max-width: none;
        margin: 0;
    }
    {% endif %}

    .tag-page {
        padding: 8rem 4rem 6rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .tag-header {
        margin-bottom: 3rem;
    }

    .tag-label {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        letter-spacing: var(--tracking-marker);
        color: var(--ink-faint);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .tag-name {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3vw, 2.2rem);
        font-weight: 300;
        color: var(--ink);
    }

    .tag-summary {
        font-family: var(--font-mono);
        font-size: var(--size-label);
        color: var(--ink-faint);
        margin-top: 0.75rem;
    }

    .tag-territory {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--ink-ghost);
    }

    .tag-territory-label {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        font-weight: 400;
        letter-spacing: var(--tracking-label);
        color: var(--ink-faint);
        text-transform: uppercase;
        margin: 0 0 1.5rem;
        padding: 0;
        border: none;
    }

    .tag-list {
        list-style: none;
    }

    .tag-entry {
        margin-bottom: 1.5rem;
    }

    .tag-entry-link {
        display: block;
        text-decoration: none;
        transition: transform 0.2s ease;
    }

    .tag-entry-link:hover {
        transform: translateX(0.5rem);
    }

    .tag-entry-kicker {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        color: var(--ink-faint);
        letter-spacing: var(--tracking-quiet);
        display: block;
        margin-bottom: 0.25rem;
    }

    .tag-entry-title {
        font-size: 1.1rem;
        font-weight: 400;
        color: var(--ink-light);
        transition: color 0.2s ease;
    }

    .tag-entry-link:hover .tag-entry-title {
        color: var(--bloom);
    }

    .tag-entry-date {
        font-family: var(--font-mono);
        font-size: var(--size-whisper);
        color: var(--ink-faint);
        margin-left: 1rem;
    }

    .tag-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--ink-ghost);
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .empty-tag {
        padding: 8rem 4rem 6rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .empty-tag p {
        color: var(--ink-faint);
        margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
        .tag-page,
        .empty-tag {
            padding: 6rem 1.5rem 3rem;
        }

        .tag-entry-date {
            display: block;
            margin-left: 0;
            margin-top: 0.15rem;
        }
    }
</style>

{% if writingOnly %}
{# Writing-only tag keeps the full-bleed writing book #}
{% set essays = tag.writing %}
{% set headerTitle = tag.name %}
{% set headerCount = tag.writing.length %}
{% set backLink = "/writing" %}
{% include "components/writing-book.njk" %}

{% elif anyContent %}
{# Multi-territory or non-writing tag renders every territory sequentially so zero items drop #}
<div class="tag-page">
    <header class="tag-header">
        <div class="tag-label">tagged</div>
        <h1 class="tag-name">{{ tag.name }}</h1>
        <div class="tag-summary">
            {%- set sep = joiner(" · ") -%}
            {%- if hasWriting %}{{ sep() }}{{ tag.writing.length }} essay{% if tag.writing.length != 1 %}s{% endif %}{% endif -%}
            {%- if hasPapers %}{{ sep() }}{{ tag.papers.length }} paper{% if tag.papers.length != 1 %}s{% endif %}{% endif -%}
            {%- if hasTalks %}{{ sep() }}{{ tag.talks.length }} talk{% if tag.talks.length != 1 %}s{% endif %}{% endif -%}
            {%- if hasPortraits %}{{ sep() }}{{ tag.portraits.length }} portrait{% if tag.portraits.length != 1 %}s{% endif %}{% endif -%}
            {%- if hasArtifacts %}{{ sep() }}{{ tag.artifacts.length }} artifact{% if tag.artifacts.length != 1 %}s{% endif %}{% endif -%}
        </div>
    </header>

    {% if hasWriting %}
    <section class="tag-territory tag-writing" aria-labelledby="tag-writing-heading">
        <h2 class="tag-territory-label" id="tag-writing-heading">writing</h2>
        <ul class="tag-list">
            {%- for essay in tag.writing -%}
            <li class="tag-entry">
                <a href="{{ essay.url | stripTrailingSlash }}" class="tag-entry-link">
                    {%- if essay.data.series -%}
                    <span class="tag-entry-kicker">{{ essay.data.series }}</span>
                    {%- endif -%}
                    <span class="tag-entry-title{% if essay.data.accident %} accident{% endif %}">{{ essay.data.title }}</span>
                    <span class="tag-entry-date">{{ essay.date | readableDate }}</span>
                </a>
            </li>
            {%- endfor -%}
        </ul>
    </section>
    {% endif %}

    {% if hasPapers %}
    <section class="tag-territory tag-papers" aria-labelledby="tag-papers-heading">
        <h2 class="tag-territory-label" id="tag-papers-heading">papers</h2>
        <ul class="tag-list">
            {%- for paper in tag.papers -%}
            <li class="tag-entry">
                <a href="{{ paper.url | stripTrailingSlash }}" class="tag-entry-link">
                    {%- if paper.data.venue -%}
                    <span class="tag-entry-kicker">{{ paper.data.venue }}</span>
                    {%- endif -%}
                    <span class="tag-entry-title">{{ paper.data.paperTitle | default(paper.data.title) }}</span>
                    <span class="tag-entry-date">{{ paper.date | readableDate }}</span>
                </a>
            </li>
            {%- endfor -%}
        </ul>
    </section>
    {% endif %}

    {% if hasTalks %}
    <section class="tag-territory tag-talks" aria-labelledby="tag-talks-heading">
        <h2 class="tag-territory-label" id="tag-talks-heading">talks</h2>
        <ul class="tag-list">
            {%- for talk in tag.talks -%}
            <li class="tag-entry">
                <a href="{{ talk.url | stripTrailingSlash }}" class="tag-entry-link">
                    {%- if talk.data.event -%}
                    <span class="tag-entry-kicker">{{ talk.data.event }}</span>
                    {%- endif -%}
                    <span class="tag-entry-title{% if talk.data.accident %} accident{% endif %}">{{ talk.data.title }}</span>
                    <span class="tag-entry-date">{{ talk.date | readableDate }}</span>
                </a>
            </li>
            {%- endfor -%}
        </ul>
    </section>
    {% endif %}

    {% if hasPortraits %}
    <section class="tag-territory tag-portraits" aria-labelledby="tag-portraits-heading">
        <h2 class="tag-territory-label" id="tag-portraits-heading">portraits</h2>
        <ul class="tag-list">
            {%- for portrait in tag.portraits -%}
            <li class="tag-entry">
                <a href="{{ portrait.url | stripTrailingSlash }}" class="tag-entry-link">
                    <span class="tag-entry-kicker">prompted by {{ portrait.data.prompter | default('unknown') }}</span>
                    <span class="tag-entry-title">{{ portrait.data.title }}</span>
                    <span class="tag-entry-date">{{ portrait.date | readableDate }}</span>
                </a>
            </li>
            {%- endfor -%}
        </ul>
    </section>
    {% endif %}

    {% if hasArtifacts %}
    <section class="tag-territory tag-artifacts" aria-labelledby="tag-artifacts-heading">
        <h2 class="tag-territory-label" id="tag-artifacts-heading">artifacts</h2>
        <ul class="tag-list">
            {%- for artifact in tag.artifacts -%}
            <li class="tag-entry">
                <a href="{{ artifact.url | stripTrailingSlash }}" class="tag-entry-link">
                    {%- if artifact.data.medium -%}
                    <span class="tag-entry-kicker">{{ artifact.data.medium }}</span>
                    {%- endif -%}
                    <span class="tag-entry-title">{{ artifact.data.title }}</span>
                    <span class="tag-entry-date">{{ artifact.date | readableDate }}</span>
                </a>
            </li>
            {%- endfor -%}
        </ul>
    </section>
    {% endif %}

    <footer class="tag-footer">
        {% if hasWriting %}<a href="/writing" class="back-link">← all writing</a>{% endif %}
        {% if hasPapers %}<a href="/papers" class="back-link">← all papers</a>{% endif %}
        {% if hasTalks %}<a href="/talks" class="back-link">← all talks</a>{% endif %}
        {% if hasPortraits or hasArtifacts %}<a href="/making" class="back-link">← all making</a>{% endif %}
    </footer>
</div>

{% else %}
<div class="empty-tag">
    <header class="tag-header">
        <div class="tag-label">tagged</div>
        <h1 class="tag-name">{{ tag.name }}</h1>
    </header>
    <p>No content found with this tag.</p>
    <a href="/writing" class="back-link">← all writing</a>
</div>
{% endif %}
